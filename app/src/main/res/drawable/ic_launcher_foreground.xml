                android:startY="28"
                android:endX="84"
                android:endY="82"
                android:type="linear">
                <item android:color="#FFFFD700" android:offset="0" />
                <item android:color="#FFD4AF37" android:offset="0.5" />
                <item android:color="#FF8A6623" android:offset="1" />
