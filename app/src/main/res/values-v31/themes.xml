<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31): Override system splash screen so it uses our dark background -->
    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">#0B0B0C</item>
        <!-- System splash screen background color (API 31+) -->
        <item name="android:windowSplashScreenBackground">#0B0B0C</item>
        <!-- Use our padded logo as the splash icon to prevent circular clipping -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <!-- Duration of splash screen (0 = dismiss immediately) -->
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
